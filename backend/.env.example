# ---------------------------------------------------------------------------
# Base de datos
# Local: el docker-compose de la raíz levanta Postgres en :5433 y ambas
# variables apuntan al mismo lugar.
# Producción (Neon):
#   DATABASE_URL → cadena "pooled" (host con -pooler), la usa la app
#   DIRECT_URL   → cadena directa (sin -pooler), la usan las migraciones
# Las dos con ?sslmode=require
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://ikk:ikk@localhost:5433/ikk_dev
DIRECT_URL=postgresql://ikk:ikk@localhost:5433/ikk_dev

# ---------------------------------------------------------------------------
# Sesión — generar cada secreto con: openssl rand -hex 64
# ---------------------------------------------------------------------------
JWT_ACCESS_SECRET=change_me_long_random_string
JWT_REFRESH_SECRET=change_me_other_long_random_string
ACCESS_TOKEN_EXPIRY=2h
REFRESH_TOKEN_EXPIRY=7d
REFRESH_TOKEN_DAYS=7
# Sólo en producción, cuando el panel y la API comparten dominio raíz.
# Ej: .tickomium.com → la cookie viaja entre ikk.* y api-ikk.*
# COOKIE_DOMAIN=

# ---------------------------------------------------------------------------
# Red
# ---------------------------------------------------------------------------
PORT=4100
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
# Orígenes adicionales permitidos, separados por coma (opcional)
# CORS_ORIGINS=https://ikk.tickomium.com

# ---------------------------------------------------------------------------
# Email (Resend)
# ---------------------------------------------------------------------------
RESEND_API_KEY=re_...
EMAIL_FROM="IKK Solutions <noreply@tickomium.com>"
# Buzón interno que recibe los avisos del formulario público
CONTACT_EMAIL_TO=contacto@ikksolutions.com

# ---------------------------------------------------------------------------
# Productos hijos. Los service tokens deben coincidir EXACTAMENTE con el
# IKK_SERVICE_TOKEN de cada hijo. Generar con: openssl rand -hex 48
# ---------------------------------------------------------------------------
API_URL_TICKOMIUM=http://localhost:4000/tickomium
API_URL_FORMATE=http://localhost:3001/api
API_URL_MDOC=http://localhost:4200/mdoc
SERVICE_TOKEN_TICKOMIUM=change_me_match_tickomium_IKK_SERVICE_TOKEN
SERVICE_TOKEN_FORMATE=change_me_match_formate_IKK_SERVICE_TOKEN
SERVICE_TOKEN_MDOC=change_me_match_mdoc_IKK_SERVICE_TOKEN

# ---------------------------------------------------------------------------
# Bootstrap del primer operador (sólo lo usa `npm run seed`)
# ---------------------------------------------------------------------------
BOOTSTRAP_ADMIN_NAME="Administrador"
BOOTSTRAP_ADMIN_EMAIL=admin@ikksolutions.com
BOOTSTRAP_ADMIN_PASSWORD=cambia_esta_contrasena_larga
